{
  "name": "site-ops-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "GA4 + Search Console の計測データを収集し、AI がサイトのコードと突き合わせて判断するための材料を出す CLI",
  "bin": {
    "site-ops": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "ops": "node --env-file-if-exists=.env --import tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "googleapis": "^144.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.6.0"
}

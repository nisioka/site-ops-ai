# === Google サービスアカウント ===
# GA4 プロパティに「閲覧者」、Search Console に「ユーザー(制限付き所有者以上)」を付与済みの
# サービスアカウント鍵 JSON へのパス。googleapis が自動で参照する。
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# === GitHub Issue 起票用 ===
# output.type = github_issue のサイトで使用。repo scope の PAT。
# ルーティン(無人)実行時は環境の Secret で注入すること。
GITHUB_TOKEN=

# === 任意: Core Web Vitals (PageSpeed Insights API) ===
# 設定すると collect 時に CWV(LCP/INP/CLS) も取得する。未設定ならスキップ。
PSI_API_KEY=

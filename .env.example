# ローカルで動作確認するときの設定。クラウド実行では Secret として注入する。
# cp .env.example .env して埋める(.env は .gitignore 済み)

# === Google サービスアカウント（どちらか一方） ===
# クラウド実行: 鍵 JSON の「本体」または base64 文字列を Secret に入れる
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ローカル実行: 鍵 JSON のファイルパス
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# === 任意: Core Web Vitals (PageSpeed Insights API) ===
# 設定すると collect 時に CWV(LCP/INP/CLS) も取得する。未設定ならスキップ
PSI_API_KEY=
